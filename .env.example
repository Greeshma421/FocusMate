# Copy this file to .env and update values for local development
# Database
DATABASE_URL=postgresql+asyncpg://focusmate:focusmatepass@localhost:5432/focusmate_dev

# JWT
JWT_SECRET_KEY=replace_this_with_a_strong_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

